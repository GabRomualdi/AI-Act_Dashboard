# EnerGuard - configurazione LLM per le spiegazioni in linguaggio naturale
# Copiate questo file in ".env" (stessa cartella) e compilate. Il file .env NON va mai
# messo nel repository o nello zip di consegna: contiene la chiave API.

# Provider: openai | anthropic | azure | compatible | none
LLM_PROVIDER=none

# Chiave API del provider (lasciare vuota per "compatible" senza autenticazione, es. Ollama locale)
LLM_API_KEY=

# Modello. Esempi: gpt-4o-mini (openai) · claude-sonnet-4-5 (anthropic)
# Per azure: il NOME DEL DEPLOYMENT. Per compatible: il nome del modello servito (es. llama3.1)
LLM_MODEL=

# Endpoint base. Obbligatorio per azure (https://<risorsa>.openai.azure.com) e compatible
# (es. http://localhost:11434/v1 per Ollama). Opzionale per openai (proxy aziendale).
LLM_BASE_URL=

# Timeout in secondi e versione API Azure
LLM_TIMEOUT=20
LLM_API_VERSION=2024-12-01-preview
